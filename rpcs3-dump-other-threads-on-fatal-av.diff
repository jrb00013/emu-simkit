+enum cpu_threads_brief_info_dump_t : u32 {};
+
+template<>
+void fmt_class_string<cpu_threads_brief_info_dump_t>::format(std::string& out, u64 arg)
+{
+	// Brief summary of every PPU and SPU thread, excluding the ones fully dumped by cpu_threads_emulation_info_dump_t.
+	// Guest watchdogs (e.g. a game's "hang detect" thread) often crash deliberately (e.g. by writing to address 0x17)
+	// after another thread stopped making progress. The faulting thread is then not the interesting one,
+	// so print where every other thread is currently waiting.
+	const u32 excluded_cpu_id = static_cast<u32>(arg);
+
+	out += "\nBrief information of other threads:\n===================================\n";
+
+	// Do not lock: this may be called from within an access violation handler
+	idm::select<named_thread<ppu_thread>>([&](u32 id, named_thread<ppu_thread>& ppu)
+	{
+		if (id == ppu_thread::id_base || id == excluded_cpu_id)
+		{
+			return;
+		}
+
+		fmt::append(out, "%s: State: %s, CIA: 0x%x, LR: 0x%x", ppu.get_name(), ppu.state.load(), ppu.cia, ppu.lr);
+
+		if (const char* func = ppu.current_function)
+		{
+			fmt::append(out, ", In function: %s", func);
+		}
+		else if (const char* last_func = ppu.last_function)
+		{
+			fmt::append(out, ", Last function: %s", last_func);
+		}
+
+		if (const u64 start_time = ppu.start_time)
+		{
+			fmt::append(out, ", Waiting: %fs", (get_guest_system_time() - start_time) / 1000000.);
+		}
+
+		out += "\n Call stack:";
+
+		for (const auto& [addr, sp] : ppu.dump_callstack_list())
+		{
+			fmt::append(out, " 0x%08x", addr);
+		}
+
+		out += '\n';
+	}, idm::unlocked);
+
+	idm::select<named_thread<spu_thread>>([&](u32 id, named_thread<spu_thread>& spu)
+	{
+		if (id == excluded_cpu_id)
+		{
+			return;
+		}
+
+		fmt::append(out, "%s: State: %s, PC: 0x%05x\n", spu.get_name(), spu.state.load(), spu.pc);
+	}, idm::unlocked);
+}
